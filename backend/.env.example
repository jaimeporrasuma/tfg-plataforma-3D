# Puerto del backend
PORT=8080

# API Key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Almacenamiento de modelos: 'firebase' o 'local'
STORAGE_PROVIDER=firebase

# Bucket de Firebase Storage (opcional, por defecto toma el project_id de las credenciales)
FIREBASE_STORAGE_BUCKET=tfgmaquetas.firebasestorage.app

# URL del server que genera los modelos 3D. 
# Si estás siguiendo el Manual de Instalación y usas iniciar-docker.bat, usa esta:
TRELLIS_URL=http://host.docker.internal:3001
# Si ejecutas el backend manualmente sin Docker en Windows, comenta la de arriba y usa esta:
# TRELLIS_URL=http://localhost:3001
