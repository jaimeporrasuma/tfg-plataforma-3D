# ==============================================================================
# CONFIGURACION DEL SERVIDOR PUENTE GPU (TFG)
# ==============================================================================

# 1. RUTA A COMFYUI (Obligatorio)
# Pon aqui la ruta ABSOLUTA de tu carpeta de ComfyUI en Windows.
# IMPORTANTE: No uses comillas al principio ni al final.
COMFYUI_WINDOWS_DIR=C:\Ruta\Hacia\Tu\ComfyUI

# 2. URL DE LA API DE COMFYUI
# Como el servidor corre en Docker, 'host.docker.internal' es el puente mágico 
# para comunicarse con el localhost de tu Windows. NO CAMBIAR.
COMFYUI_API_URL=http://host.docker.internal:8188