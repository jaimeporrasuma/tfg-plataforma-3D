# ==============================================================================
# CONFIGURACION DEL SERVIDOR PUENTE GPU (TFG)
# ==============================================================================

# 1. PUERTO DEL SERVIDOR PUENTE
PORT=3001

# 2. RUTA A COMFYUI
# Pon aqui la ruta ABSOLUTA de tu carpeta de ComfyUI en Windows.
# IMPORTANTE: No uses comillas al principio ni al final.
# Esta variable solo se utilizará en caso de ejecución manual y no a través de Docker.
COMFYUI_WINDOWS_DIR=C:\Ruta\Hacia\Tu\ComfyUI

# 3. URL DE LA API DE COMFYUI MEDIANTE DOCKER
# NO CAMBIAR si usas Docker (en Windows nativo suele ser http://127.0.0.1:8188).
COMFYUI_API_URL=http://host.docker.internal:8188

# 4. TIEMPO MAXIMO DE ESPERA (En milisegundos, por defecto 15 minutos)
COMFYUI_TIMEOUT_MS=900000